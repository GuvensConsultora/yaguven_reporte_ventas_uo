<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form del wizard: se elige el rango y se exporta -->
    <record id="view_reporte_ventas_uo_wizard_form" model="ir.ui.view">
        <field name="name">yaguven.reporte.ventas.uo.wizard.form</field>
        <field name="model">yaguven.reporte.ventas.uo.wizard</field>
        <field name="arch" type="xml">
            <form string="Ventas por Unidad Operativa">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_export_excel" type="object"
                            string="Exportar Excel" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reporte_ventas_uo_wizard" model="ir.actions.act_window">
        <field name="name">Ventas por Unidad Operativa</field>
        <field name="res_model">yaguven.reporte.ventas.uo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú propio y no una entrada dentro de Contabilidad: es donde lo tenían en el sistema
         anterior (`lupatini_reporte_diario.menu_ventas_uo_root`, secuencia 50) y donde la persona
         que lo usa lo busca. Se replica la misma estructura: raíz «Ventas por U.O.» con el reporte
         adentro, las dos limitadas al grupo. -->
    <menuitem
        id="menu_reporte_ventas_uo_root"
        name="Ventas por U.O."
        groups="group_reporte_ventas_uo"
        sequence="50"/>

    <menuitem
        id="menu_reporte_ventas_uo"
        name="Ventas por Unidad Operativa"
        parent="menu_reporte_ventas_uo_root"
        action="action_reporte_ventas_uo_wizard"
        groups="group_reporte_ventas_uo"
        sequence="10"/>

</odoo>
